# Default: Gemini free tier. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any LiteLLM model string works. Run `python scripts/list_gemini_models.py` to see Gemini models for your key.
LLM_MODEL=gemini/gemini-flash-lite-latest

# Optional: other providers (only needed if you pick them in the UI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# For Ollama (local, no key): install Ollama, run `ollama pull qwen2.5:7b`, then LLM_MODEL=ollama/qwen2.5:7b

# Tuning (defaults shown)
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# FALLBACK_MODELS=gemini/gemini-flash-latest,gemini/gemini-3.5-flash
# LLM_TIMEOUT_S=30
# TOP_K=4
# RETRIEVAL_THRESHOLD=0.80
# ANSWER_THRESHOLD=0.6
